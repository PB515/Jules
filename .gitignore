# Dependencies
node_modules/
.pnp
.pnp.js

# Secrets — never commit (Safety Rail 2)
.env
.env.local
.env*.local

# Next.js / build output
.next/
out/
build/
dist/

# Supabase local stack
.branches/
.temp/
supabase/.temp/

# Logs & OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code local settings + transient files (machine-specific)
.claude/settings.local.json
.claude/*.lock

# Real credentials — never committed, local reference only
docs/runbooks/demo-credentials.md

# DB backups (scripts/backup-db.mjs) — real student PII, never committed;
# copy these somewhere outside this repo/machine instead.
/backups/

# Raw asset staging folder — the user's local source dump for generated
# images/videos; already copied into template/public/* in organized form,
# committing the raw duplicate here would just double the repo's binary size.
/Images & Videos/
~$*.docx
